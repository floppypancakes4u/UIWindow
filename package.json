{
  "name": "@spify/app-window",
  "version": "0.1.0",
  "description": "Draggable, resizable, snappable multi-window manager for React. Renders arbitrary content in managed floating windows.",
  "author": "floppypancakes4u",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/floppypancakes4u/UIWindow.git"
  },
  "bugs": {
    "url": "https://github.com/floppypancakes4u/UIWindow/issues"
  },
  "homepage": "https://github.com/floppypancakes4u/UIWindow#readme",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./tailwind-preset": "./tailwind-preset.cjs"
  },
  "files": [
    "dist",
    "tailwind-preset.cjs",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && node scripts/add-use-client.mjs",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^29.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tsup": "^8.5.0",
    "typescript": "^5",
    "vitest": "^4.1.0"
  },
  "keywords": [
    "react",
    "window",
    "window-manager",
    "draggable",
    "resizable",
    "floating-window",
    "ui"
  ]
}
